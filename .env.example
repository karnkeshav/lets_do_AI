# ─────────────────────────────────────────────────────────────
# AI for EveryOne Workshop — Secret Keys Reference
# ─────────────────────────────────────────────────────────────
#
# These are NOT used directly by the app (it's a static site).
# Add each key as a GitHub repository secret:
#   GitHub → repo → Settings → Secrets and variables → Actions
#   → New repository secret
#
# The deploy workflow reads them and writes config.js at build time.
# ─────────────────────────────────────────────────────────────

# Google Apps Script Web App URL
# (from: Apps Script → Deploy → Manage deployments → copy URL)
GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Razorpay live publishable key (safe to be in frontend code)
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID

# Fine-grained GitHub PAT — scope: lets_do_AI repo, Contents: Read+Write
# Create at: GitHub → Settings → Developer settings
#   → Personal access tokens → Fine-grained tokens → Generate new token
CSV_GITHUB_TOKEN=github_pat_YOUR_TOKEN_HERE
